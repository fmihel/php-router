        "firebase/php-jwt": "^6.10 || ^7.0"
    },
    "require-dev": {
        "fmihel/console-log": "^1.8"
    },
    "config": {
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-y2cr-5h3j-g3ys": "Требуется для поддержки PHP 7.4; используются надежные ключи"
                }
            }
        }
    }
}